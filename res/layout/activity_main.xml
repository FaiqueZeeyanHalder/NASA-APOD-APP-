<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->

        <!-- Loading -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/nasa_apod"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:ignore="VisualLintSystemUi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/astronomy_picture_of_the_day"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:visibility="gone" />

        <!-- Main Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/apodImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/nasa_astronomy_picture_of_the_day"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ApodImageShape"
            tools:src="@android:drawable/ic_menu_gallery" />

        <!-- Date -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.08"
            android:text="@string/september_27_2026"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/the_astronomy_picture_of_the_day"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <!-- Explanation -->
        <TextView
            android:id="@+id/explanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nasa_s_explanation_will_appear_here"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <!-- Copyright -->
        <TextView
            android:id="@+id/copyrightText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="© NASA / Goddard" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/divider" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dateButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:maxWidth="320dp"
                android:text="@string/select_date"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/button_border"
                android:backgroundTint="@color/background"
                android:textColor="@color/text_primary"
                tools:ignore="VisualLintButtonSize" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:maxWidth="320dp"
                android:text="@string/share"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/button_dark"
                android:textColor="@color/button_text"
                tools:ignore="VisualLintButtonSize" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
